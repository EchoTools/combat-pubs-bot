# ── Discord ───────────────────────────────────────────────────────────────────
# Webhook URL for posting match/queue embeds
# Create one in your Discord channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

# (Optional) Bot token for auto-pinning messages.
# Create a bot at https://discord.com/developers/applications and invite it
# with the Manage Messages permission. Leave blank to disable pinning.
DISCORD_BOT_TOKEN=

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# How often to poll (milliseconds)
POLL_INTERVAL_MS=10000

# (Optional) Limit embeds to a specific guild/group ID. Leave blank for all guilds.
FILTER_GUILD_ID=

# ── Nakama (optional — enables authenticated API access) ─────────────────────
# When all four values are set, the bot authenticates with Nakama and uses the
# authenticated match/public RPC. Session tokens are acquired via
# account/authenticate/password and refreshed via device/auth/refresh.
# If not configured, the bot falls back to the public status endpoint.
#
# Nakama server base URL (no trailing slash, no /v2)
NAKAMA_URL=
# HTTP key for unauthenticated RPC calls (Nakama runtime.http_key)
NAKAMA_HTTP_KEY=
# Bot account credentials (dedicated Nakama account for the bot)
NAKAMA_USERNAME=
NAKAMA_PASSWORD=