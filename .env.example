# ── Nakama ────────────────────────────────────────────────────────────────────
# URL of your Nakama server (no trailing slash)
NAKAMA_URL=http://localhost:7350

# The HTTP key — used only for token refresh
NAKAMA_HTTP_KEY=defaultkey

# Your Nakama JWT (Bearer token). Get it from the portal:
#   1. Open https://echovrce.com in your browser and log in
#   2. Open DevTools (F12) -> Application -> Local Storage -> site URL
#   3. Copy the value of the key: jwt
NAKAMA_TOKEN=

# Your Nakama refresh token (optional but recommended for auto-renewal).
# Same location as above — copy the value of the key: refreshToken
NAKAMA_REFRESH_TOKEN=

# ── Discord ───────────────────────────────────────────────────────────────────
# Full webhook URL: https://discord.com/api/webhooks/<id>/<token>
# Create one in your Discord channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

# (Optional) Discord bot token — enables automatic pinning of messages.
# Create a bot at https://discord.com/developers/applications and invite it
# with the Manage Messages permission. Leave blank to disable pinning.
DISCORD_BOT_TOKEN=

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# How often to poll Nakama (milliseconds). 10000 = 10 seconds
POLL_INTERVAL_MS=10000

# (Optional) If set, filters queue and match embeds to this guild/group ID only
# Leave blank to show all Combat activity across all guilds
FILTER_GUILD_ID=
